<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.synapsetest.testmanagement.mapper.TestEnvironmentMapper">

    <!-- Result Map for TestEnvironment -->
    <resultMap id="TestEnvironmentResultMap" type="com.synapsetest.testmanagement.model.TestEnvironment">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="url" column="url"/>
        <result property="config" column="config" typeHandler="com.synapsetest.testmanagement.config.JsonMapTypeHandler"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- Select by ID -->
    <select id="selectById" resultMap="TestEnvironmentResultMap">
        SELECT * FROM test_environments WHERE id = #{id}
    </select>

    <!-- Select All -->
    <select id="selectAll" resultMap="TestEnvironmentResultMap">
        SELECT * FROM test_environments
    </select>

    <!-- Select by Name -->
    <select id="selectByName" resultMap="TestEnvironmentResultMap">
        SELECT * FROM test_environments WHERE name = #{name}
    </select>

    <!-- Select by Status -->
    <select id="selectByStatus" resultMap="TestEnvironmentResultMap">
        SELECT * FROM test_environments WHERE status = #{status}
    </select>

    <!-- Insert -->
    <insert id="insert" parameterType="com.synapsetest.testmanagement.model.TestEnvironment">
        INSERT INTO test_environments(
            id, name, description, url, status, config, created_at, updated_at
        ) VALUES (
            #{id},
            #{name},
            #{description},
            #{url},
            #{status},
            #{config, typeHandler=com.synapsetest.testmanagement.config.JsonMapTypeHandler},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <!-- Update -->
    <update id="update" parameterType="com.synapsetest.testmanagement.model.TestEnvironment">
        UPDATE test_environments SET
            name = #{name},
            description = #{description},
            url = #{url},
            status = #{status},
            config = #{config, typeHandler=com.synapsetest.testmanagement.config.JsonMapTypeHandler},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <!-- Delete by ID -->
    <delete id="deleteById">
        DELETE FROM test_environments WHERE id = #{id}
    </delete>

    <!-- Count -->
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM test_environments
    </select>

</mapper>

