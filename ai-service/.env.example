# AI服务环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置值

# ============ 缓存配置 ============
# Redis开关: true=使用Redis分布式缓存, false=使用内存缓存(默认)
ENABLE_REDIS=false

# Redis连接配置 (仅当ENABLE_REDIS=true时需要)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_password_here
REDIS_DB=0

# 缓存配置
# 缓存过期时间(秒), 默认5分钟
CACHE_TTL=300
# 内存缓存最大条目数
CACHE_MAX_SIZE=1000

# ============ 数据库配置 ============
# MySQL配置 (用于存储历史测试用例、测试标准等数据)
# 支持两种配置方式，选择其一即可：
# 方式1: URI格式（推荐，配置简单）
MYSQL_URI=mysql://root:synapsetest123@localhost:3306/synapsetest

# 方式2: 分离参数（可选，如果设置了 MYSQL_URI 则以下配置会被忽略）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=synapsetest123
MYSQL_DATABASE=synapsetest

# ============ LLM配置 ============
# LLM提供商选择
# 支持的提供商:
#   - mock: 模拟模型，用于测试和开发
#   - qwen-local: 本地运行的Qwen模型
#   - qwen-api: 通义千问API服务
#   - deepseek-local: 本地运行的DeepSeek模型
#   - deepseek-api: DeepSeek API服务
LLM_PROVIDER=qwen-api

# ============ Qwen模型配置 ============
# 本地Qwen模型路径 (当LLM_PROVIDER=qwen-local时需要)
# QWEN_MODEL_PATH=/models/Qwen-7B-Chat

# Qwen API配置 (当LLM_PROVIDER=qwen-api时需要)
LLM_API_KEY=sk-36ffcd39b71f4340a7131a6d49a09a58
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ============ DeepSeek模型配置 ============
# 本地DeepSeek模型路径 (当LLM_PROVIDER=deepseek-local时需要)
# DEEPSEEK_MODEL_PATH=/models/deepseek-coder-6.7b-instruct
# DeepSeek模型名称 (deepseek-coder, deepseek-chat等)
# DEEPSEEK_MODEL_NAME=deepseek-coder

# DeepSeek API配置 (当LLM_PROVIDER=deepseek-api时需要)
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat

# ============ 通用模型运行配置 ============
# GPU使用配置
USE_GPU=false
MAX_GPU_MEMORY=16GB

# 模型生成参数（通用）
# MAX_TOKENS: 单次生成的最大 token 数，影响返回内容的长度
# TEMPERATURE: 采样温度 (0-1)，值越高输出越随机/创造性，越低越确定性
# TOP_P: Top-p 采样参数 (0-1)，控制采样的多样性
MAX_TOKENS=3072
TEMPERATURE=0.7
TOP_P=0.9

# 边界测试用例专用配置
# 边界测试通常需要更多 tokens（更详细的场景描述）和更高的创造性
EDGE_CASE_MAX_TOKENS=3072
EDGE_CASE_TEMPERATURE=0.8

# ============ 向量数据库配置 ============
# Qdrant配置 (用于语义搜索和RAG)
# QDRANT_MODE:
#   - memory: 内存模式，无需外部服务器，适合开发/测试（当前使用）
#   - server: 服务器模式，需要运行 Qdrant 容器，适合生产环境
QDRANT_MODE=memory

# 以下配置仅在 QDRANT_MODE=server 时需要
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=your_api_key_here

# Milvus配置 (备选向量数据库)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# ============ 应用配置 ============
# 应用运行端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 调试模式
DEBUG=false
LOG_LEVEL=INFO

# CORS配置
CORS_ORIGINS=*

# ============ AI模型配置 ============
# 语义相似度阈值 (0-1)
SIMILARITY_THRESHOLD=0.85

# ============ 高级配置 ============
# 数据库类型（目前固定为 mysql）
DATABASE_TYPE=mysql

# 向量数据库类型（qdrant 或 milvus）
VECTOR_DB_TYPE=qdrant

# Qdrant gRPC 端口（仅在 QDRANT_MODE=server 且使用 gRPC 时需要）
# QDRANT_GRPC_PORT=6334
